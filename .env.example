# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.

# Database (chỉ dùng chữ và số cho mật khẩu để không phải URL-encode)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/familytree

# Auth — tạo bằng: openssl rand -hex 32
JWT_SECRET=
SECURE_COOKIE=true

# Tài khoản admin ban đầu cho db:seed
ADMIN_ACC=admin
ADMIN_PASS=

# Cloudflare Tunnel
TUNNEL_TOKEN=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Web Push — tạo bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
